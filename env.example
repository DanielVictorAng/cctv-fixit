# Copy to .env.local for local development.
# On Vercel: Project -> Settings -> Environment Variables (add each one, all environments).
# Only the two NEXT_PUBLIC_ values reach the browser; everything else is server-only.

# --- Supabase -> Project Settings -> API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Customer updates (docs/04-integrations.md; sending starts in Phase 3) ---
# Meta: Page access token for the Messenger Send API.
MESSENGER_PAGE_ACCESS_TOKEN=
# Viber: bot auth token from partners.viber.com.
VIBER_AUTH_TOKEN=

# --- outbound_queue drain (GET /api/cron/outbound) ---
# Any long random string. Vercel Cron sends it automatically as
# "Authorization: Bearer <value>" when this variable exists. Unset => 401.
CRON_SECRET=
