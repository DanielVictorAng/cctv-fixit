# Copy to .env.local for local development.
# On Vercel: Project -> Settings -> Environment Variables (add each one, all environments).
# Only the two NEXT_PUBLIC_ values reach the browser; everything else is server-only.

# --- Supabase -> Project Settings -> API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n (optional) ---
# Only needed if n8n forwards webhooks. Must match n8n's N8N_WEBHOOK_SECRET.
# Leave empty to disable the n8n path; raw platform signatures still work.
N8N_WEBHOOK_SECRET=

# --- Meta Messenger -> developers.facebook.com -> your app ---
# The exact string you type into the app's Webhook "Verify Token" field.
MESSENGER_VERIFY_TOKEN=
# App Secret. Validates the X-Hub-Signature-256 header.
MESSENGER_APP_SECRET=
# Page access token. Required to send replies.
MESSENGER_PAGE_ACCESS_TOKEN=

# --- Viber -> partners.viber.com -> your bot ---
VIBER_AUTH_TOKEN=

# --- outbound_queue drain (GET /api/cron/outbound) ---
# Any long random string. Vercel Cron sends it automatically as
# "Authorization: Bearer <value>" when this variable exists. Unset => 401.
CRON_SECRET=
