# Copy to n8n/.env  (used by docker compose)
# Must match N8N_WEBHOOK_SECRET in the app's .env.local
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string

# How the n8n container reaches the Next.js app:
#   Docker Desktop  -> http://host.docker.internal:3000
#   Linux VPS       -> http://172.17.0.1:3000 (or the host's LAN IP)
NEXT_APP_URL=http://host.docker.internal:3000

# ---------------------------------------------------------------------------
# UGREEN NAS only (docker-compose.nas.yml)
# ---------------------------------------------------------------------------
# Data lives at /volume1/docker/n8n on the NAS. Before first start:
#     sudo chown -R 1000:1000 /volume1/docker/n8n
#
# NEXT_APP_URL is the container's view of your LAN. host.docker.internal does
# NOT work here — inside that container it resolves to the NAS itself.
#   Next.js running on your PC -> http://192.168.1.50:3000   (your PC's LAN IP)
#   Next.js also on the NAS    -> http://cctv-fixit-web:3000 (same Docker net)
#   Deployed app               -> https://your-app.example
#
# Public identity — only needed once Meta/Viber webhooks point at n8n, i.e. once
# a tunnel or reverse proxy (Cloudflare Tunnel, Nginx Proxy Manager) fronts it:
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# N8N_SECURE_COOKIE=true
# WEBHOOK_URL=https://n8n.example.com/
